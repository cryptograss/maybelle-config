[Unit]
Description=GoAccess traffic dashboard for {{ goaccess_site }} ({{ goaccess_public_host }})
After=network.target caddy.service

[Service]
User={{ goaccess_user }}
Group={{ goaccess_user }}
# The log as Caddy writes it (JSON), followed as it grows; the dashboard page written once and kept live
# over a WebSocket the browser reaches through Caddy at wss://{{ goaccess_public_host }}/stats/ws.
# --persist and --restore keep what was counted across restarts and Caddy's log rolls; --anonymize-ip
# zeroes the last octet (the last 64 bits of an IPv6) before an address is kept anywhere.
ExecStart=/usr/bin/goaccess {{ goaccess_log }} \
    --log-format=CADDY \
    --no-global-config \
    --real-time-html \
    --addr=127.0.0.1 --port={{ goaccess_port }} \
    --ws-url=wss://{{ goaccess_public_host }}:443/stats/ws \
    --output={{ goaccess_dir }}/index.html \
    --persist --restore --db-path={{ goaccess_dir }}/db \
    --anonymize-ip \
    --html-report-title="{{ goaccess_public_host }}"
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ goaccess_dir }}
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
