#!/bin/bash
# pam_exec, as an SSH session opens: say in magenta who came in, and as which
# account -- root above all. Who is known by the key they used, matched
# against the people's keys in hunter's inventory (/etc/magenta/ssh-people);
# a key nobody's known by is said by its fingerprint. Never stands in a
# login's way: it answers at once and tells magenta in the background.
[ "$PAM_TYPE" = open_session ] || exit 0
[ "$PAM_USER" = sshrouter ] && exit 0   # hunter's route-ssh says more of these
PEOPLE=/etc/magenta/ssh-people

# The key's fingerprint: from sshd's own word to PAM, or else its log line.
FP=''
if [ -n "$SSH_AUTH_INFO_0" ]; then
  FP=$(printf '%s\n' "$SSH_AUTH_INFO_0" | awk '$1 == "publickey" {print $2, $3; exit}' | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
fi
if [ -z "$FP" ]; then
  FP=$( { journalctl -o cat --since '-2min' 2>/dev/null; tail -n 200 /var/log/auth.log 2>/dev/null; } \
    | grep "Accepted publickey for ${PAM_USER} from ${PAM_RHOST} " | tail -n 1 | grep -o 'SHA256:[A-Za-z0-9+/]*')
fi

WHO=''
if [ -n "$FP" ] && [ -r "$PEOPLE" ]; then
  while read -r name type body; do
    [ -n "$body" ] || continue
    if [ "$(printf '%s %s\n' "$type" "$body" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')" = "$FP" ]; then
      WHO=$name; break
    fi
  done < "$PEOPLE"
fi
case "$WHO" in @*) exit 0 ;; esac   # a machine's own key (maybelle's deploys): they say themselves
if [ -n "$WHO" ]; then KEY=''; else WHO=someone; KEY=$FP; fi
# Only someone at a keyboard is said. PAM can't tell: sshd opens the session
# before it gives it a terminal (PAM_TTY is "ssh" either way, checked). So
# the background job looks a moment later at what this session is running --
# everything under the sshd process this hook was called from -- and says it
# only if something there has a terminal, and isn't one of maybelle-config's
# deploy scripts (deploy-hunter.sh and the rest, run over ssh -t), which say
# themselves as a redeploy. A script's ssh host cmd, scp, or mosh starting
# its server has no terminal, or is gone by then: maybelle's own deploy is
# six of those in a minute.
SESSION_PID=$PPID
setsid bash -c '
  sleep 2
  pids=" $1 "; table=$(ps -eo pid=,ppid= 2>/dev/null)   # in memory: a root hook writes no files
  for _ in 1 2 3 4 5 6; do   # six levels down is plenty: sshd, its child, the shell, the script
    while read -r pid ppid; do
      case "$pids" in *" $ppid "*) case "$pids" in *" $pid "*) ;; *) pids="$pids$pid " ;; esac ;; esac
    done <<< "$table"
  done
  at_keyboard=''
  for pid in $pids; do
    tr "\0" " " < /proc/$pid/cmdline 2>/dev/null | grep -q "maybelle-config/maybelle/scripts/" && exit 0
    case "$(ps -o tty= -p "$pid" 2>/dev/null)" in *pts/*) at_keyboard=yes ;; esac
  done
  [ -n "$at_keyboard" ] || exit 0
  shift
  exec /usr/local/bin/announce-ssh "$@"
' _ "$SESSION_PID" "$WHO" "" "" "$PAM_USER" "$KEY" </dev/null >/dev/null 2>&1 &
exit 0
