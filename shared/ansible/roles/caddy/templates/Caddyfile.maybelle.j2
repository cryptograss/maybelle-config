{
    email admin@justinholmes.com
}

# Jenkins (automatic TLS with Let's Encrypt)
{{ domain_name }} {
    reverse_proxy localhost:{{ jenkins_port }} {
        # Tell Jenkins about the original protocol and host
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {{ domain_name }}
    }
}

# Build previews on port 8081 (optional, can deprecate if problematic)
{{ domain_name }}:8081 {
    root * {{ jenkins_home }}/www/builds
    file_server browse
}

# Memory Lane web UI
memory-lane.{{ domain_name }} {
    # Both of magenta's names count in one traffic log (roles/goaccess reads it).
    log {
        output file /var/log/caddy/magenta-access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
    }
    reverse_proxy localhost:3000
}

# Magenta: the same memory-lane, under its own name. The bare address is
# magenta's own front page (magenta#114).
magenta.cryptograss.live {
    # The access log: who came, from where, for what. Kept 30 days, then rolled
    # off; nothing in the browser (Justin, #performance, 12 Nov).
    log {
        output file /var/log/caddy/magenta-access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
    }

    # The traffic dashboard GoAccess draws from that log (roles/goaccess): its
    # page, and the WebSocket that keeps it live. The hash is in the vault.
    basicauth /stats/* {
        stats {{ stats_password_hash }}
    }
    handle /stats/ws {
        reverse_proxy 127.0.0.1:7890
    }
    handle_path /stats/* {
        root * /var/lib/goaccess/magenta
        file_server
    }

    reverse_proxy localhost:3000
}

# MCP server (for Claude Code memory access)
mcp.{{ domain_name }} {
    reverse_proxy 10.0.0.2:8000
}

# githouse's repositories to read, read-only (roles/cgit; Justin, #ramp, 11 Nov)
code.{{ domain_name }} {
    reverse_proxy localhost:8890
}

# GlitchTip error tracking (open source Sentry alternative)
glitchtip.{{ domain_name }} {
    reverse_proxy localhost:8800
}

# GlitchTip DSN endpoint (for automated pickipedia config)
glitchtip-dsn.{{ domain_name }} {
    basicauth {
        deploy {{ glitchtip_dsn_fetch_password_hashed }}
    }
    root * /mnt/persist/glitchtip
    file_server {
        index pickipedia-dsn.txt
    }
}

