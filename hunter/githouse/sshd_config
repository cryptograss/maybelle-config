# Only git, only by key, only through githouse auth (the forced command in each key's line).
Port 22
HostKey /srv/git/.host-keys/ssh_host_ed25519_key
AuthorizedKeysFile /etc/githouse/authorized_keys
AllowUsers git
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTTY no
StrictModes no
