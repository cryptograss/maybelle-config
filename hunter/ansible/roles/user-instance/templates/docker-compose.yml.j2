version: '3.8'

services:
  {{ user.name }}-arthel:
    image: magenta-arthel:latest  # Uses pre-built image, no build step
    container_name: {{ user.name }}-arthel
    hostname: {{ user.name }}@hunter
    ports:
      - "{{ user.ssh_port }}:22"
      # code-server web IDE (18080 for justin, 18081 for rj, etc.)
      - "{{ 18080 + (user.ssh_port - 2222) }}:8080"
      # Port range: {{ user.port_range_start }}-{{ user.port_range_start + 9 }}
      # Maps to container ports 4000-4009
      - "{{ user.port_range_start }}-{{ user.port_range_start + 9 }}:4000-4009"
      # Mosh UDP port range (60000-61000 in container, mapped to unique range per user)
      - "{{ user.mosh_port_start | default(60000 + (user.ssh_port - 2222) * 100) }}-{{ user.mosh_port_start | default(60000 + (user.ssh_port - 2222) * 100) + 99 }}:60000-60099/udp"
      # NOTE: PickiPedia runs as sibling container (not inside arthel), so no port mapping here.
      # Pickipedia containers bind directly to host ports 4005-4007.
    volumes:
      # Mount entire home directory to persist workspace, .claude, bash history, etc
      - {{ base_dir }}/{{ user.name }}/home:/home/magent
      # SSH keys mounted separately (read-only for security)
      - {{ base_dir }}/{{ user.name }}/.ssh:/home/magent/.ssh:ro
{% if user.motion is not defined %}
      # Root on hunter, in effect: a person's own container only. A Mood's
      # container never gets it, so full tools there stay inside it.
      - /var/run/docker.sock:/var/run/docker.sock
{% endif %}
      # PickiPedia backups (synced from maybelle daily)
      - /opt/magenta/pickipedia-backups:/opt/magenta/pickipedia-backups:ro
      # Motion poller: the deployed memory-lane main (build-image role keeps it
      # current), not a workspace checkout that could be on any branch
      - {{ base_dir }}/memory-lane-source/poller:/opt/motion-poller:ro
    networks:
      - magenta-net
    environment:
      - DEVELOPER_NAME={{ user.name }}
      - DEVELOPER_FULL_NAME={{ user.full_name }}
      - DEVELOPER_EMAIL={{ user.email }}
      - DEVELOPER_GITHUB={{ user.github_username }}
      - POSTGRES_HOST=magenta-postgres
      - POSTGRES_DB={{ postgres_db }}
      - POSTGRES_USER=magent
{% if user.motion is not defined %}
      - POSTGRES_PASSWORD={{ postgres_password }}
{% endif %}
{% if memory_lane_preview_db_password is defined %}
      # memory-lane previews (tools/preview.sh) connect to the live record as
      # the restricted memory_lane_preview role, not as magent
      - MEMORY_LANE_PREVIEW_DB_PASSWORD={{ memory_lane_preview_db_password }}
{% endif %}
      - CODE_SERVER_PASSWORD={{ user.code_server_password }}
      - GH_TOKEN={{ user.github_token | default('') }}
      - DJANGO_SECRET_KEY={{ user.django_secret_key | default('') }}
      - SSH_PORT={{ user.ssh_port }}
      # Use private network for MCP on hunter (10.0.0.2 is maybelle)
      - MCP_MEMORY_URL=http://10.0.0.2:8000
      # PickiPedia bot credentials for MediaWiki MCP server
      - PICKIPEDIA_BOT_PASSWORD={{ PICKIPEDIA_BOT_PASSWORD }}
      # Blue Railroad import bot credentials
      - BLUERAILROAD_BOT_USERNAME={{ BLUERAILROAD_BOT_USERNAME | default('') }}
      - BLUERAILROAD_BOT_PASSWORD={{ BLUERAILROAD_BOT_PASSWORD | default('') }}
      # Sentry/GlitchTip DSN for PickiPedia dev error tracking
      - PICKIPEDIA_DEV_SENTRY_DSN={{ pickipedia_dev_sentry_dsn | default('') }}
      # Delivery-kid pinning service API key
      - DELIVERY_KID_API_KEY={{ delivery_kid_api_key }}
      # Opt-in: container_startup.py starts the Motion poller when this is 1
      - MOTION_POLLER={{ '1' if user.motion_poller | default(false) else '0' }}
{% if user.motion is defined %}
      # A Mood's container: its poller answers this Mood, with full tools
      # for the people in it; no arthel checkout in its workspace.
      - MOTION_SLUG={{ user.motion }}
      - MOTION_FULL_TOOLS_FOR={{ user.people | default([]) | join(',') }}
      - SKIP_ARTHEL=1
{% endif %}
{% if user.motion_poller | default(false) and memory_lane_runner_key is defined %}
      # The poller streams the turns it wakes straight into their Motions with
      # this (memory-lane's MOTION_RUNNER_KEYS). Only the poller reads it, so it
      # is not exported to shells.
      - MEMORY_LANE_RUNNER_KEY={{ memory_lane_runner_key }}
{% endif %}
    restart: unless-stopped

networks:
  magenta-net:
    external: true
    name: magenta-net
