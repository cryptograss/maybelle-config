version: '3.8'

services:
  {{ user.name }}-arthel:
    image: magenta-arthel:latest  # Uses pre-built image, no build step
    container_name: {{ user.name }}-arthel
    hostname: {{ user.name }}@hunter
{% if user.memory_limit is defined %}
    # Its own ceiling: a runaway here can't starve the rest of hunter, or
    # another agent (agency-<name>).
    mem_limit: {{ user.memory_limit }}
{% endif %}
{% if user.cpus is defined %}
    cpus: {{ user.cpus }}
{% endif %}
{% if user.kind | default('') != 'agent' %}
    ports:
      - "{{ user.ssh_port }}:22"
      # code-server web IDE (18080 for justin, 18081 for rj, etc.)
      - "{{ 18080 + (user.ssh_port - 2222) }}:8080"
      # Port range: {{ user.port_range_start }}-{{ user.port_range_start + 9 }}
      # Maps to container ports 4000-4009
      - "{{ user.port_range_start }}-{{ user.port_range_start + 9 }}:4000-4009"
      # Mosh UDP port range (60000-61000 in container, mapped to unique range per user)
      - "{{ user.mosh_port_start | default(60000 + (user.ssh_port - 2222) * 100) }}-{{ user.mosh_port_start | default(60000 + (user.ssh_port - 2222) * 100) + 99 }}:60000-60099/udp"
      # NOTE: PickiPedia runs as sibling container (not inside arthel), so no port mapping here.
      # Pickipedia containers bind directly to host ports 4005-4007.
{% endif %}
    volumes:
      # Mount entire home directory to persist workspace, .claude, bash history, etc
      - {{ base_dir }}/{{ user.name }}/home:/home/magent
      # SSH keys mounted separately (read-only for security)
      - {{ base_dir }}/{{ user.name }}/.ssh:/home/magent/.ssh:ro
{% if user.mood is not defined %}
      # Root on hunter, in effect: a person's own container only. A Mood's
      # container never gets it, so full tools there stay inside it.
      - /var/run/docker.sock:/var/run/docker.sock
{% endif %}
      # PickiPedia backups (synced from maybelle daily)
      - /opt/magenta/pickipedia-backups:/opt/magenta/pickipedia-backups:ro
      # Mood poller: memory-lane as deployed, in hunter's clone of magenta main
      # (build-image keeps it current), not a workspace checkout on any branch
      - {{ memory_lane_dir }}/poller:/opt/mood-poller:ro
{% for agent in user.agents | default([]) %}
      # {{ agent.name }}'s home, kept across recreation (hunter/scripts/agent_homes.py)
      - {{ base_dir }}/{{ user.name }}/agents/{{ agent.name }}:/home/{{ agent.name }}
{% endfor %}
    networks:
      - magenta-net
    environment:
      - DEVELOPER_NAME={{ user.name }}
      - DEVELOPER_FULL_NAME={{ user.full_name }}
      - DEVELOPER_EMAIL={{ user.email }}
      - DEVELOPER_GITHUB={{ user.github_username }}
      - POSTGRES_HOST=magenta-postgres
      - POSTGRES_DB={{ postgres_db }}
      - POSTGRES_USER=magent
{% if user.mood is not defined %}
      - POSTGRES_PASSWORD={{ postgres_password }}
{% endif %}
{% if memory_lane_preview_db_password is defined %}
      # memory-lane previews (tools/preview.sh) connect to the live record as
      # the restricted memory_lane_preview role, not as magent
      - MEMORY_LANE_PREVIEW_DB_PASSWORD={{ memory_lane_preview_db_password }}
{% endif %}
      - CODE_SERVER_PASSWORD={{ user.code_server_password }}
      - GH_TOKEN={{ user.github_token | default('') }}
      - DJANGO_SECRET_KEY={{ user.django_secret_key | default('') }}
      - SSH_PORT={{ user.ssh_port | default('') }}
      # agent: an agent's own container (agency-<name>), which starts only
      # what its agents need (container_startup.py)
      - CONTAINER_KIND={{ user.kind | default('') }}
      # Use private network for MCP on hunter (10.0.0.2 is maybelle)
      - MCP_MEMORY_URL=http://10.0.0.2:8000
      # PickiPedia bot credentials for MediaWiki MCP server
      - PICKIPEDIA_BOT_PASSWORD={{ PICKIPEDIA_BOT_PASSWORD }}
      # Blue Railroad import bot credentials
      - BLUERAILROAD_BOT_USERNAME={{ BLUERAILROAD_BOT_USERNAME | default('') }}
      - BLUERAILROAD_BOT_PASSWORD={{ BLUERAILROAD_BOT_PASSWORD | default('') }}
      # Sentry/GlitchTip DSN for PickiPedia dev error tracking
      - PICKIPEDIA_DEV_SENTRY_DSN={{ pickipedia_dev_sentry_dsn | default('') }}
      # Delivery-kid pinning service API key
      - DELIVERY_KID_API_KEY={{ delivery_kid_api_key }}
      # Opt-in: container_startup.py starts the Mood poller when this is 1
      - MOOD_POLLER={{ '1' if user.mood_poller | default(false) else '0' }}
{% if user.mood is defined %}
      # A Mood's container: its poller answers this Mood, with full tools
      # for the people in it; no arthel checkout in its workspace.
      - MOOD_SLUG={{ user.mood }}
      - MOOD_FULL_TOOLS_FOR={{ user.people | default([]) | join(',') }}
      - SKIP_ARTHEL=1
{% endif %}
{% if user.mood_poller | default(false) %}
      # magent's poller signs in with the subscription's setup-token (from
      # `claude setup-token`; long-lived, for processes nobody logs into), not
      # a /login made by hand in each container, which expires. The agents'
      # claude_code_oauth_token, unless magent has its own. Only the poller
      # and the turns it wakes get it (container_startup.py write_poller_env).
      - MAGENT_CLAUDE_CODE_OAUTH_TOKEN={{ magent_claude_code_oauth_token | default(claude_code_oauth_token | default('')) }}
{% if user.magent_also_harness | default('') == 'pi' %}
      # magent on Pi too, for other vendors' models (container_startup.py setup_magent_pi):
      # OpenRouter's key, shared with the agents (model_openrouter_api_key), only in its poller's env.
      - MAGENT_ALSO_HARNESS=pi
      - MAGENT_OPENROUTER_API_KEY={{ magent_openrouter_api_key | default(model_openrouter_api_key | default('')) }}
{% endif %}
{% if user.magent_instructions | default(false) %}
      # magent's instructions from PickiPedia, given to each turn as system prompt
      # (magenta poller/instructions.py, --instructions), as the agents' are.
      - MAGENT_INSTRUCTIONS=1
{% endif %}
{% endif %}
{% set magent_key = magent_runner_key | default(memory_lane_runner_key | default('')) %}
{% if user.mood_poller | default(false) and magent_key %}
      # The poller streams the turns it wakes straight into their Moods with
      # this (memory-lane's MOOD_RUNNER_KEYS). Only the poller reads it, so it
      # is not exported to shells. magent_runner_key, once named
      # memory_lane_runner_key: either works.
      - MEMORY_LANE_RUNNER_KEY={{ magent_key }}
{% endif %}
{% if user.agents is defined %}
      # Agents besides magent who live in this Mood's container, each its own
      # unix user (hunter/CONTAINERS.md). Their keys, from the vault, are
      # written into their own homes at startup, readable only by them.
      - 'AGENTS={{ user.agents | to_json }}'
{% for agent in user.agents %}
{% set prefix = 'AGENT_' ~ (agent.name | upper | replace('-', '_')) %}
      - {{ prefix }}_RUNNER_KEY={{ lookup('vars', agent.name ~ '_runner_key', default='') }}
      - {{ prefix }}_PICKIPEDIA_BOT_PASSWORD={{ lookup('vars', agent.name ~ '_pickipedia_bot_password', default='') }}
{# A vendor's key is shared by every agent (model_<vendor>_api_key), unless one has its own (<agent>_<vendor>_api_key). #}
{% for vendor, env_name in (agent.model_keys | default({})).items() %}
      - {{ prefix }}_KEY_{{ env_name }}={{ lookup('vars', agent.name ~ '_' ~ vendor ~ '_api_key', default=lookup('vars', 'model_' ~ vendor ~ '_api_key', default='')) }}
{% endfor %}
{# The subscription: a token from `claude setup-token`, shared the same way (claude_code_oauth_token, or
   <agent>_claude_code_oauth_token). Claude Code reads it as CLAUDE_CODE_OAUTH_TOKEN. Not Pi: Anthropic
   refuses the subscription to other harnesses (400, "Third-party apps now draw from your extra usage"),
   and Pi would read ANTHROPIC_OAUTH_TOKEN ahead of any ANTHROPIC_API_KEY. Anthropic's models run on
   Claude Code instead (the agent's also_harness). #}
{% set subscription = lookup('vars', agent.name ~ '_claude_code_oauth_token', default=lookup('vars', 'claude_code_oauth_token', default='')) %}
      - {{ prefix }}_KEY_CLAUDE_CODE_OAUTH_TOKEN={{ subscription }}
{% endfor %}
{% endif %}
    restart: unless-stopped

networks:
  magenta-net:
    external: true
    name: magenta-net
