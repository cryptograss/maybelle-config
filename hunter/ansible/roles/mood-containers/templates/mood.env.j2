# What every Mood's own container (mood-<id>) shares, from the vault: read by hunter-mood-containers'
# compose files (env_file). The same as a Mood's container in docker-compose.yml.j2 gets, less what is
# its own (its name, its ports, its Mood), which the process writes. Keep the two in step.
DEVELOPER_FULL_NAME=magent-cryptograss
DEVELOPER_EMAIL=magent@cryptograss.live
DEVELOPER_GITHUB=magent-cryptograss
POSTGRES_HOST=magenta-postgres
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER=magent
{% if memory_lane_preview_db_password is defined %}
MEMORY_LANE_PREVIEW_DB_PASSWORD={{ memory_lane_preview_db_password }}
{% endif %}
CODE_SERVER_PASSWORD={{ code_server_password }}
GH_TOKEN={{ magent_github_token }}
DJANGO_SECRET_KEY=
CONTAINER_KIND=
MCP_MEMORY_URL=http://10.0.0.2:8000
PICKIPEDIA_BOT_PASSWORD={{ PICKIPEDIA_BOT_PASSWORD }}
BLUERAILROAD_BOT_USERNAME={{ BLUERAILROAD_BOT_USERNAME | default('') }}
BLUERAILROAD_BOT_PASSWORD={{ BLUERAILROAD_BOT_PASSWORD | default('') }}
PICKIPEDIA_DEV_SENTRY_DSN={{ pickipedia_dev_sentry_dsn | default('') }}
DELIVERY_KID_API_KEY={{ delivery_kid_api_key }}
MOOD_POLLER=1
SKIP_ARTHEL=1
MAGENT_CLAUDE_CODE_OAUTH_TOKEN={{ magent_claude_code_oauth_token | default(claude_code_oauth_token | default('')) }}
MAGENT_INSTRUCTIONS=1
{% if magent_runner_key is defined %}
MEMORY_LANE_RUNNER_KEY={{ magent_runner_key }}
{% endif %}
