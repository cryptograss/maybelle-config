#!/bin/bash
# Tell magenta someone has come in by SSH (memory-lane POST /api/access/ssh/):
# said in #general, once a visit. Run in the background by route-ssh; it never
# delays or stops a login -- no key, no network, no answer, and it just ends.
#   announce-ssh <who> <whose container> <how: "a shell" | "tmux <session>" | "a command">
KEY_FILE=/etc/magenta/access-key
[ -r "$KEY_FILE" ] || exit 0
WHO=$1 INTO=$2 HOW=$3
BODY=$(printf '{"server": "hunter", "who": "%s", "into": "%s", "how": "%s"}' "$WHO" "$INTO" "$HOW")
curl -s -m 5 -o /dev/null -X POST \
  -H "Authorization: Bearer $(cat "$KEY_FILE")" -H 'Content-Type: application/json' \
  --data "$BODY" https://magenta.cryptograss.live/api/access/ssh/ || true
