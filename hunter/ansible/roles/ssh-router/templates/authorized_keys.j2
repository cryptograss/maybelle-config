# Auto-generated authorized_keys for SSH routing
# Each key routes to its owner's container

{# Every person with a key is routed: to their own container while they still have one,
   else to workbench, the people's box (route-ssh). A Mood's directory is reached by its
   slug: `ssh sshrouter@hunter chartifacts`. #}
{% for person in people if person.ssh_pubkey | default('') | trim is match('ssh-') %}
# {{ person.full_name }} ({{ person.email }})
command="/usr/local/bin/route-ssh {{ person.name }}",no-port-forwarding,no-X11-forwarding,no-agent-forwarding {{ person.ssh_pubkey | trim }}

{% endfor %}
