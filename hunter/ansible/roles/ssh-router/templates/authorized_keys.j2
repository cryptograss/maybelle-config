# Auto-generated authorized_keys for SSH routing
# Each key routes to its owner's container

{# A Mood's container has no key of its own: people reach it on its own port. #}
{% for user in users if user.motion is not defined %}
# {{ user.full_name }} ({{ user.email }})
command="/usr/local/bin/route-ssh {{ user.name }}",no-port-forwarding,no-X11-forwarding,no-agent-forwarding {{ user.ssh_pubkey }}

{% endfor %}
