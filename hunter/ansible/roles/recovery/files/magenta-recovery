#!/bin/bash
# magenta-recovery: the one thing recovery@hunter does (its authorized_keys
# force it). `magenta.sh recovery` lands here: Claude Code -- magent -- on
# hunter's host, in a tmux session that outlives the connection.
#
# For when Justin and magent can't reach each other at all: the containers
# are down, Docker is wedged, the Moods are unreachable. Not for one Mood
# being quiet. See hunter/ansible/roles/recovery.
set -euo pipefail
cd "$HOME"

if [ "${1:-}" = "--claude" ]; then
    # Inside tmux. Claude Code, billed through OpenRouter (Anthropic's models,
    # OpenRouter's Anthropic-compatible API), not the subscription the agents
    # share: recovery mustn't depend on the thing that may be what broke. The
    # key goes into this process's environment only, never onto a command line
    # where ps would show it. Without a key, Claude Code asks for /login.
    unset CLAUDE_CODE_OAUTH_TOKEN
    if [ -r "$HOME/.config/magenta/openrouter_key" ]; then
        ANTHROPIC_AUTH_TOKEN="$(cat "$HOME/.config/magenta/openrouter_key")"
        export ANTHROPIC_AUTH_TOKEN
        export ANTHROPIC_BASE_URL=https://openrouter.ai/api
        export ANTHROPIC_API_KEY=""  # empty, or Claude Code goes to Anthropic itself
        # OpenRouter's names for them, pinned: what /model's opus, sonnet and
        # haiku mean here.
        export ANTHROPIC_DEFAULT_OPUS_MODEL=anthropic/claude-opus-5.5
        export ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-5.5
        export ANTHROPIC_DEFAULT_HAIKU_MODEL=anthropic/claude-haiku-5.5
    fi
    exec "$HOME/.local/bin/claude" --model opus --mcp-config "$HOME/.config/magenta/mcp.json"
fi

# What `magenta.sh recovery [--fresh]` asked for, through ssh.
case "${SSH_ORIGINAL_COMMAND:-}" in
    "") ;;
    fresh) tmux kill-session -t recovery 2>/dev/null || true ;;
    *)
        echo "magenta-recovery: this login only opens the recovery session ('fresh' starts it over)." >&2
        exit 2
        ;;
esac
exec tmux new-session -A -s recovery /usr/local/bin/magenta-recovery --claude
