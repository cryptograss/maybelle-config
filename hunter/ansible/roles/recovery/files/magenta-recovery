#!/bin/bash
# magenta-recovery: the one thing recovery@hunter does (its authorized_keys
# force it). `magenta.sh recovery` lands here: magent, on hunter's host, in a
# tmux session that outlives the connection.
#
# For when Justin and magent can't reach each other at all: the containers
# are down, Docker is wedged, the Moods are unreachable. Not for one Mood
# being quiet. See hunter/ansible/roles/recovery.
#
# Two ways in, each its own tmux session, sharing nothing but hunter and its
# network, so that if part of the trouble is one of them, the other is a word
# away (Justin, 2026-10-16):
#   openrouter    Pi, on OpenRouter's credits: Anthropic's models by default,
#                 any vendor's by /model (the default, when there's a key)
#   subscription  Claude Code, on the Claude subscription, by the setup-token
#                 the agents share (or /login, without one)
set -euo pipefail
cd "$HOME"
KEYS="$HOME/.config/magenta"

if [ "${1:-}" = "--session" ]; then
    # Inside tmux. A credential goes into this process's environment only,
    # never onto a command line where ps would show it.
    route="${2:-}"
    unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_API_KEY OPENROUTER_API_KEY
    export MAGENTA_RECOVERY_ROUTE="$route"
    case "$route" in
        openrouter)
            if [ ! -r "$KEYS/openrouter_key" ]; then
                echo "No OpenRouter key on hunter (recovery_openrouter_api_key or model_openrouter_api_key in the vault)."
                echo "Try: magenta.sh recovery --subscription"
                sleep 30
                exit 1
            fi
            OPENROUTER_API_KEY="$(cat "$KEYS/openrouter_key")"
            export OPENROUTER_API_KEY
            # Pi and its own Node; its rules, memory and gate are in ~/.pi/agent.
            export PATH="$HOME/.local/node/bin:$HOME/.local/pi/bin:$PATH"
            exec "$HOME/.local/pi/bin/pi" --model openrouter/anthropic/claude-opus-5.5
            ;;
        subscription)
            # Without the token, Claude Code asks for /login: still the subscription.
            if [ -r "$KEYS/claude_token" ]; then
                CLAUDE_CODE_OAUTH_TOKEN="$(cat "$KEYS/claude_token")"
                export CLAUDE_CODE_OAUTH_TOKEN
            fi
            exec "$HOME/.local/bin/claude" --model opus --mcp-config "$KEYS/mcp.json"
            ;;
        *)
            echo "magenta-recovery: no such route: '$route'" >&2
            exit 2
            ;;
    esac
fi

# What `magenta.sh recovery [--fresh] [--openrouter|--subscription]` asked
# for, through ssh: plain words, nothing else.
fresh=no
route=""
read -ra words <<< "${SSH_ORIGINAL_COMMAND:-}"
for word in "${words[@]}"; do
    case "$word" in
        fresh) fresh=yes ;;
        openrouter|subscription) route="$word" ;;
        *)
            echo "magenta-recovery: this login only opens the recovery session" \
                 "(words: fresh, openrouter, subscription)." >&2
            exit 2
            ;;
    esac
done
if [ -z "$route" ]; then
    if [ -r "$KEYS/openrouter_key" ]; then route=openrouter; else route=subscription; fi
fi
session="recovery-$route"
if [ "$fresh" = yes ]; then
    tmux kill-session -t "$session" 2>/dev/null || true
fi
exec tmux new-session -A -s "$session" /usr/local/bin/magenta-recovery --session "$route"
