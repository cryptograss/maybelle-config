#!/usr/bin/python3 -I
"""recovery-log-ship: recovery@hunter's sessions, to the recovery log on maybelle, as they happen.

A system service (root, restarted if it stops), not part of any session.
Every couple of seconds it looks for new lines in the session transcripts
(Claude Code's and Pi's) and in recovery-alert's queue, and sends each over
ssh, with a key that can do nothing on maybelle but append
(shared/ansible/roles/recovery-log). What has reached maybelle can't be
changed from hunter. What hasn't yet (maybelle down, the network gone) waits
here, and a session with root can change it before it goes: the log says
when each line arrived, so a late one reads as what it is.
"""
import json
import os
import subprocess
import sys
import time

HOME = '/home/recovery'
SOURCES = [f'{HOME}/.claude/projects', f'{HOME}/.pi/agent', '/var/lib/magenta-recovery']
STATE = '/var/lib/magenta-recovery-ship/offsets.json'
KEY = '/etc/magenta/recovery-log-key'
KNOWN = '/var/lib/magenta-recovery-ship/known_hosts'
SINK = os.environ.get('RECOVERY_LOG_SINK', 'recovery-log@10.0.0.2')
PAUSE = 2.0


def transcripts():
    for root in SOURCES:
        for directory, _, files in os.walk(root):
            for name in files:
                if name.endswith('.jsonl'):
                    yield os.path.join(directory, name)


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(offsets):
    tmp = STATE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(offsets, f)
    os.replace(tmp, STATE)


def send(batch):
    """One ssh call for what's new; True only if maybelle took all of it."""
    try:
        done = subprocess.run(
            ['ssh', '-i', KEY, '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes',
             '-o', f'UserKnownHostsFile={KNOWN}', '-o', 'StrictHostKeyChecking=accept-new',
             '-o', 'ConnectTimeout=10', '-T', SINK],
            input=batch, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return done.returncode == 0


def new_lines(path, offset):
    """Whole lines past `offset`, and where they end. A file that shrank starts over."""
    try:
        size = os.path.getsize(path)
        if size < offset:
            offset = 0
        if size == offset:
            return [], offset
        with open(path, 'rb') as f:
            f.seek(offset)
            chunk = f.read(size - offset)
    except OSError:
        return [], offset
    end = chunk.rfind(b'\n')
    if end < 0:
        return [], offset
    return chunk[:end].split(b'\n'), offset + end + 1


def cycle(offsets):
    """Send what's new in every transcript. Offsets move only once maybelle has the
    lines; until then they wait, and go next time."""
    batch, ends = [], {}
    for path in transcripts():
        lines, end = new_lines(path, offsets.get(path, 0))
        ends[path] = end
        relative = path[len(HOME) + 1:] if path.startswith(HOME + '/') else path
        batch += [relative.encode() + b'\t' + line + b'\n' for line in lines]
    if not batch or send(b''.join(batch)):
        offsets.update(ends)
        save(offsets)


def main():
    offsets = load()
    if not offsets:
        # The first start: what's already there is history, kept on hunter, not news.
        offsets = {path: os.path.getsize(path) for path in transcripts()}
        save(offsets)
    while True:
        cycle(offsets)
        time.sleep(PAUSE)


if __name__ == '__main__':
    sys.exit(main())
