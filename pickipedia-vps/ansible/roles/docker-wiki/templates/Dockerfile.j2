# PickiPedia Production Container
# Thin image — MediaWiki code is bind-mounted from /var/www/pickipedia
# MariaDB socket is mounted from host

FROM php:8.2-apache

# Install PHP extensions needed by MediaWiki
RUN apt-get update && apt-get install -y \
    libicu-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    imagemagick \
    ffmpeg \
    lua5.4 \
    liblua5.4-dev \
    git \
    unzip \
    curl \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        intl \
        mysqli \
        opcache \
        gd \
        zip \
        calendar \
        bcmath \
    && pecl install apcu \
    && docker-php-ext-enable apcu \
    && rm -rf /var/lib/apt/lists/*

# Apache configuration
RUN a2enmod rewrite headers
RUN sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf

# Let encoded slashes through to MediaWiki.
#
# Wiki subpage titles contain "/" — "Grass Talk Radio/GTR-190" and so on — and
# the REST API percent-encodes that as %2F in the path. Apache's default is to
# reject any request whose path contains an encoded slash, returning its own
# 404 before PHP is ever reached. The effect is that every subpage on the wiki
# can be created through the API but never read or edited again, which makes
# bot-maintained subpages a one-way trip.
#
# NoDecode passes the sequence through still encoded, leaving MediaWiki to
# decode it — which is what it expects. Plain "On" would decode it in Apache
# and reintroduce the path ambiguity the default is there to prevent.
#
# Set in the vhost as well as the server config on purpose: virtual hosts do
# not inherit this directive, so the server-level setting alone has no effect
# on requests that a vhost handles, which here is all of them.
RUN printf '\n# See Dockerfile: subpage titles need encoded slashes preserved.\nAllowEncodedSlashes NoDecode\n' >> /etc/apache2/apache2.conf \
    && sed -i 's|<VirtualHost \*:80>|<VirtualHost *:80>\n\tAllowEncodedSlashes NoDecode|' /etc/apache2/sites-available/000-default.conf

# PHP configuration matching current production settings
RUN { \
    echo 'memory_limit = 256M'; \
    echo 'upload_max_filesize = 2G'; \
    echo 'post_max_size = 2100M'; \
    echo 'max_execution_time = 600'; \
    echo 'max_input_time = 600'; \
    echo 'max_input_vars = 5000'; \
    echo 'file_uploads = On'; \
    echo ''; \
    echo '; OPcache'; \
    echo 'opcache.enable = 1'; \
    echo 'opcache.memory_consumption = 256'; \
    echo 'opcache.max_accelerated_files = 10000'; \
    echo 'opcache.validate_timestamps = 1'; \
    echo 'opcache.revalidate_freq = 60'; \
    echo ''; \
    echo '; APCu'; \
    echo 'apc.enabled = 1'; \
    echo 'apc.shm_size = 128M'; \
    echo ''; \
    echo '; Error handling'; \
    echo 'display_errors = Off'; \
    echo 'log_errors = On'; \
    echo ''; \
    echo '; Date/time'; \
    echo 'date.timezone = UTC'; \
    echo ''; \
    echo '; MySQL socket (mounted from host)'; \
    echo 'mysqli.default_socket = /var/run/mysqld/mysqld.sock'; \
    echo 'pdo_mysql.default_socket = /var/run/mysqld/mysqld.sock'; \
    } > /usr/local/etc/php/conf.d/mediawiki.ini

# No disable_functions or open_basedir — container is the sandbox
# This is what makes Scribunto (proc_open, shell_exec) work without fuss

EXPOSE 80
